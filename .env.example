# Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# API URL for fetching match data
# Example: https://surebetsapp.com/app_json_scrits/json_toppicks.php
API_URL=your_api_url_here

# Telegram Bot Token (get from @BotFather)
# Example: 589590135:AAG535MoncA24m_4EdDLHlPGg...
BOT_TOKEN=your_bot_token_here

# Telegram Channel ID (use @userinfobot to get ID)
# Example: -1001247200123
CHANNEL_ID=your_channel_id_here

# Debug Mode (set to "true" for testing, "false" for production)
# When true, sends test messages and runs immediately
DEBUG_MODE=false

# n8n Configuration (if running with n8n)
# Set the working directory where your Python script is located
SCRIPT_PATH=/app/telegram_match_poster.py

# Optional: Additional configuration for monitoring and alerts
# NOTIFICATION_EMAIL=admin@yourdomain.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...